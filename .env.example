# From your MAL app registration (Profile Settings > API). Used both for this
# app's own OAuth2 + PKCE login flow (/auth/login, /auth/callback) and to
# authenticate MAL's public API endpoints (search, ranking, detail, season).
# The app's registered redirect URI must be set to
# http://localhost:3001/auth/callback (adjust the port if you changed it).
MAL_CLIENT_ID=

# Optional. Overrides the reader used as a fallback when the stream source blocks this
# app's egress IP (Cloudflare answers Vercel's AWS range with a 403 bot challenge while
# allowing other networks). Defaults to https://r.jina.ai/ — a free third-party service
# with no availability guarantee, which is why it is only ever tried after a direct fetch.
#
# Must be base64-encoded, e.g. `aHR0cHM6Ly9yLmppbmEuYWkv` for https://r.jina.ai/.
# A value that fails to decode is ignored in favour of the default.
STREAM_READER_URL=

# Optional. Set to 1 to enable the adult reader: the /doujin section (nhentai) and nhentai as
# a last-resort source for adult MAL titles. Leave it off for any build that ships inside the
# Android app — Google Play bans sexual content, and the TWA is this same site.
ENABLE_ADULT_READER=

# Optional. An nhentai API key (nhentai.net → Settings → API keys). Doubles its per-IP rate
# limit (10 → 20 searches a minute), which a busy deployment will need.
NHENTAI_API_KEY=

# Optional. A proxy for AniList's GraphQL API, used only after a direct call is rate-limited
# or challenged. AniList allows 30 requests a minute per egress IP; on a shared-egress host
# (Cloudflare Workers) that budget is spent by other tenants on the same address, so the
# direct call can fail regardless of this app's own traffic. Unset means direct-only, which
# is right for local development.
#
# Must forward the POST method and body unchanged — a GET-only reader (such as the one
# STREAM_READER_URL points at) cannot proxy GraphQL. The request URL is this value with the
# AniList endpoint appended, so include any trailing slash or `?url=` the proxy expects.
#
# Must be base64-encoded, like STREAM_READER_URL. A value that fails to decode is ignored.
ANILIST_PROXY_URL=

# Optional, and only meaningful alongside ANILIST_PROXY_URL. If the proxy is configured with
# a SHARED_SECRET, set the same value here and it is sent as `X-Proxy-Secret` to the proxy
# only — never to AniList. Lets the proxy refuse callers that are not this app. See
# `proxy/README.md`.
ANILIST_PROXY_SECRET=
